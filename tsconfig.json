{
  "compilerOptions": {
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "strict": true,
    "moduleResolution": "Node",
    "outDir": "./build"
  },
  "include": [
    "index.ts",
    "controllers/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
